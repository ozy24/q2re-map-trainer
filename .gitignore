vcpkg/vcpkg.exe
vcpkg/vcpkg.disable-metrics
vcpkg/buildtrees/
vcpkg/packages/
vcpkg/downloads/
vcpkg/installed/

# Build output (keep dist/README.md tracked)
dist/*.dll
dist/*.lib
dist/*.exp
dist/*.pdb
dist/*.zip
dist/_zip_inspect/

